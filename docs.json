{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "VylarisGroup Docs",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": {
    "light": "https://media.vylaris.ch/logo/light.png",
    "dark": "https://media.vylaris.ch/logo/standard.png"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Company",
        "pages": [
          "ueber-uns",
          "karriere",
          "partnerschaften"
        ]
      },
      {
        "tab": "Services",
        "pages": [
          "lebenslaeufe-service",
          "forms-alternative",
          "pastebin",
          "vylarischat",
          "billing-and-payment"
        ]
      }
    ]
  },
  "logo": {
    "light": "https://media.vylaris.ch/logo/light.png",
    "dark": "https://media.vylaris.ch/logo/standard.png",
    "href": "https://vylaris.ch"
  },
  "navbar": {
    "links": [
      {
        "href": "https://vylaris.ch",
        "label": "Website"
      },
      {
        "href": "https://suite.vylaris.ch",
        "label": "Products (comming soon)"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.mintlify.com"
    }
  },
  "contextual": {
    "options": [
     "copy",
     "view",
     "chatgpt",
     "claude",
     "perplexity",
     "mcp",
     "cursor",
     "vscode"
   ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/vylarisgroup",
      "discord": "https://dc.vylaris.ch",
      "website": "https://vylaris.ch"
    }
  },
  "appearance": {
    "default": "dark"
  },
  "errors": {
    "404": {
      "redirect": true,
      "title": "Was tust du hier?",
      "description": "Diese Seite solltest du nicht sehen. Bitte gehe zurück!"
    }
  },
  "seo": {
    "indexing": "navigable"
  }
}
